# URL del backend. En desarrollo puede omitirse: el código usa
# http://localhost:3001/api por defecto.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Login con Google de los postulantes (Supabase Auth).
# Se obtienen en: Supabase → Project Settings → API
#   - NEXT_PUBLIC_SUPABASE_URL  = Project URL (el mismo SUPABASE_URL del backend)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY = la clave "anon public" (NUNCA la service_role)
#
# Además hay que habilitar el proveedor de Google en:
#   Supabase → Authentication → Providers → Google
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
